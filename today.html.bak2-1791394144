<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>📋 Сегодня: разбор задач</title>
<style>
  :root { --paper:#FAFAF6; --card:#FFFFFF; --ink:#22261F; --muted:#6C7367;
    --line:#E1E4D9; --accent:#2A5C48; --accent-soft:#EDF3EE; --ok-bg:#E4F0E8;
    --warn:#8A5A18; --warn-bg:#F7EFDC; --danger:#9A3B2E;
    --mono:ui-monospace,"SF Mono",Menlo,monospace; --serif:Georgia,serif;
    --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif; }
  @media (prefers-color-scheme: dark) {
    :root { --paper:#191C17; --card:#20241E; --ink:#E6E8E0; --muted:#9BA394;
      --line:#343930; --accent:#7FBBA0; --accent-soft:#24322A; --ok-bg:#1F3027;
      --warn:#D9A85C; --warn-bg:#322A18; --danger:#E08A7C; } }
  *{box-sizing:border-box}
  body{background:var(--paper);color:var(--ink);font-family:var(--sans);margin:0;padding:26px 14px 90px;font-size:14px}
  .wrap{max-width:860px;margin:0 auto}
  h1{font-family:var(--serif);font-weight:400;font-size:24px;margin:0 0 2px}
  .sub{color:var(--muted);font-size:12px;margin-bottom:14px}
  .bar{display:flex;gap:8px;align-items:center;margin-bottom:14px;flex-wrap:wrap}
  .bar a,.bar button{padding:7px 12px;font:inherit;font-size:12.5px;border:1px solid var(--line);border-radius:6px;background:var(--card);color:var(--accent);text-decoration:none;cursor:pointer}
  .note{padding:9px 12px;border-radius:6px;background:var(--warn-bg);color:var(--warn);font-size:13px;margin-bottom:12px}
  .note[hidden]{display:none}
  .list{margin:0;padding:0;list-style:none;border:1px solid var(--line);border-radius:8px;background:var(--card);overflow:hidden}
  .row{padding:11px 14px;border-top:1px solid var(--line)}
  .row:first-child{border-top:0}
  .row.over{box-shadow:inset 3px 0 0 var(--danger)}
  .head{display:flex;gap:10px;align-items:baseline}
  .n{font-family:var(--mono);color:var(--muted);font-size:12px;min-width:26px}
  .t{flex:1;line-height:1.4;cursor:pointer}
  .t.open{white-space:pre-wrap}
  .chip{font-size:11px;font-weight:600;padding:0 7px;border-radius:999px;background:var(--accent-soft);color:var(--accent);margin-left:6px}
  .chip.over{background:var(--warn-bg);color:var(--danger)}
  .btns{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0 0 36px}
  .btns button{padding:5px 11px;font:inherit;font-size:12.5px;border:1px solid var(--line);border-radius:6px;background:var(--card);color:var(--ink);cursor:pointer}
  .btns button:hover{border-color:var(--accent);color:var(--accent)}
  .btns .ok{background:var(--ok-bg);border-color:var(--accent);color:var(--accent);font-weight:600}
  .btns button:disabled{opacity:.5;cursor:default}
  .empty{padding:24px;text-align:center;color:var(--muted)}
  button:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
</style>
</head>
<body>
<div class="wrap">
  <div class="bar"><a href="index.html">← Главная</a><a href="tasks.html">✅ Все задачи</a><button type="button" id="reload">↻ Обновить</button></div>
  <h1 id="h1">📋 Разбор задач</h1>
  <div class="bar" id="days"></div>
  <div class="sub" id="sub">Загрузка…</div>
  <div class="note" id="note" hidden></div>
  <ul class="list" id="list"></ul>
</div>
<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var RECUR = /🔁\s*Каждые\s+(\d+)\s+дн/;
  var tasks = [], busy = false;
  function pad(n) { return ('0' + n).slice(-2); }
  function iso(d) { return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()); }
  var qd = (/[?&]d=(\d{4}-\d{2}-\d{2})/.exec(location.search) || [])[1];
  function today() { return iso(new Date()); }
  function view() { return qd || today(); }                 // какой день разбираем (по умолчанию сегодня)
  function plus(n) { var p = view().split('-'); var d = new Date(+p[0], +p[1] - 1, +p[2]); d.setDate(d.getDate() + n); return iso(d); }
  function dm(s) { return s ? s.slice(8, 10) + '.' + s.slice(5, 7) : '—'; }
  function note(t) { var n = $('note'); n.textContent = t || ''; n.hidden = !t; }

  // заголовок без служебных пометок переноса: режем по «. » (точка с пробелом), даты вида 07.10 не ломаются
  function title(txt) {
    var s = String(txt).replace(/\n/g, ' ');
    var segs = s.split(/\.\s+/);
    var i = 0;
    while (i < segs.length - 1 && /^(⏭|🕒|📝|📌|✔ последний раз|✅ Уточнение)/.test(segs[i])) i++;
    var out = segs.slice(i).join('. ');
    var m = /^🔗 слито[^:]*\):\s*(.+)$/.exec(out);
    return (m ? m[1] : out) || String(txt);
  }

  function render() {
    var ul = $('list'); ul.textContent = ''; var td = view();
    var open = tasks.filter(function (t) { return !t.done && !t.arch && t.date && t.date <= td; })
                    .sort(function (a, b) { return a.date < b.date ? -1 : a.date > b.date ? 1 : a.id - b.id; });
    $('sub').textContent = (qd ? 'День ' + dm(td) : 'Сегодня ' + dm(td)) + ': открытых ' + open.length + (qd ? ' (и просроченных до этого дня)' : '') + '. Кнопка «+N» считает от ' + dm(td) + '.';
    if (!open.length) { var li0 = document.createElement('li'); li0.className = 'empty'; li0.textContent = 'На сегодня задач нет 🎉'; ul.appendChild(li0); return; }
    open.forEach(function (t, i) {
      var li = document.createElement('li'); li.className = 'row' + (t.date < td ? ' over' : '');
      var head = document.createElement('div'); head.className = 'head';
      var n = document.createElement('span'); n.className = 'n'; n.textContent = (i + 1) + '.';
      var tt = document.createElement('span'); tt.className = 't'; tt.textContent = title(t.txt).slice(0, 220) + (title(t.txt).length > 220 ? '…' : '');
      tt.title = 'Нажми, чтобы раскрыть полный текст';
      var full = false;
      tt.addEventListener('click', function () { full = !full; tt.classList.toggle('open', full); tt.textContent = full ? t.txt : title(t.txt).slice(0, 220) + (title(t.txt).length > 220 ? '…' : ''); });
      if (t.date < td) { var c = document.createElement('span'); c.className = 'chip over'; c.textContent = 'просрочено с ' + dm(t.date); tt.appendChild(c); }
      head.appendChild(n); head.appendChild(tt); li.appendChild(head);
      var b = document.createElement('div'); b.className = 'btns';
      [[1, '+1 д'], [2, '+2 д'], [7, '+7 д'], [31, '+31 д']].forEach(function (p) {
        var btn = document.createElement('button'); btn.type = 'button'; btn.textContent = p[1];
        btn.addEventListener('click', function () { act(t.id, 'move', p[0]); }); b.appendChild(btn);
      });
      var ok = document.createElement('button'); ok.type = 'button'; ok.className = 'ok'; ok.textContent = '✔ Решено';
      ok.addEventListener('click', function () { act(t.id, 'done'); }); b.appendChild(ok);
      li.appendChild(b); ul.appendChild(li);
    });
  }

  function load() {
    return fetch('/api/tasks', { cache: 'no-store' }).then(function (r) { return r.json(); })
      .then(function (d) { tasks = d.tasks || []; render(); note(''); })
      .catch(function () { note('Нет связи с трекером (localhost:8765). Запусти сервер.'); });
  }

  // каждый раз берём свежий список, меняем одну задачу и пишем обратно с rev
  function act(id, kind, days) {
    if (busy) return; busy = true;
    fetch('/api/tasks', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (d) {
      var t = (d.tasks || []).filter(function (x) { return x.id === id; })[0];
      if (!t) { note('Задача уже исчезла, обновляю.'); tasks = d.tasks || []; return null; }
      var td = new Date(), tds = today(), old = t.date;
      if (kind === 'move') {
        t.date = plus(days);
        t.txt = '⏭ ' + dm(old) + ' → ' + dm(t.date) + ' (кнопка «+' + days + ' д» от ' + dm(view()) + ', нажато ' + dm(tds) + '). ' + t.txt;
      } else {
        var m = RECUR.exec(t.txt);
        if (m) {
          t.date = plus(parseInt(m[1], 10));
          t.txt = t.txt.replace(/(✔ последний раз [0-9.]+\. )?/, '');
          t.txt = '✔ последний раз ' + dm(tds) + '. ' + t.txt;
        } else {
          t.done = true; t.txt += ' ✅ ' + dm(tds) + ' решено кнопкой.';
        }
      }
      d.rev = (d.rev || 0) + 1;
      return fetch('/api/tasks', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(d) }).then(function (r) {
        if (r.status === 409) { note('Данные изменились в другом окне. Подтянул свежие, нажми кнопку ещё раз.'); return null; }
        if (!r.ok) throw new Error('http ' + r.status);
        tasks = d.tasks; note(''); return true;
      });
    }).then(function () { return load(); })
      .catch(function () { note('Не удалось сохранить. Проверь, что трекер запущен.'); })
      .then(function () { busy = false; });
  }

  (function buildDays() {
    var box = $('days'), WD = ['вс', 'пн', 'вт', 'ср', 'чт', 'пт', 'сб'];
    for (var i = 0; i < 7; i++) {
      var d = new Date(); d.setDate(d.getDate() + i); var k = iso(d);
      var a = document.createElement('a'); a.href = 'today.html' + (i === 0 ? '' : '?d=' + k);
      a.textContent = (i === 0 ? 'Сегодня ' : WD[d.getDay()] + ' ') + dm(k);
      if (k === view()) { a.style.background = 'var(--accent-soft)'; a.style.fontWeight = '700'; }
      box.appendChild(a);
    }
  })();
  $('reload').addEventListener('click', load);
  document.addEventListener('visibilitychange', function () { if (!document.hidden && !busy) load(); });
  load();
})();
</script>
</body>
</html>
